@@ -0,0 +1,60 @@
+package com.kodjodevf.mangayomi;
+
+import android.app.Instrumentation;
+import android.content.Intent;
+import android.os.Build;
+import android.os.Bundle;
+import android.os.SystemClock;
+
+/** Device test only; excluded from the distributed APK. Uses no sync account. */
+public class SyncServiceInstrumentation extends Instrumentation {
+    @Override public void onCreate(Bundle arguments) {
+        super.onCreate(arguments);
+        start();
+    }
+
+    private void check(boolean condition, String message) {
+        if (!condition) throw new AssertionError(message);
+    }
+
+    @Override public void onStart() {
+        Bundle result = new Bundle();
+        Intent service = new Intent(getTargetContext(), SyncBackgroundService.class);
+        try {
+            // The normal app starts the service while visible, then can go home.
+            Intent launch = getTargetContext().getPackageManager()
+                .getLaunchIntentForPackage(getTargetContext().getPackageName());
+            launch.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+            getTargetContext().startActivity(launch);
+            SystemClock.sleep(3000);
+            service.putExtra("title", "同步背景服務測試");
+            service.putExtra("text", "驗證切換 App、關閉螢幕與完成後清理");
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+                getTargetContext().startForegroundService(service);
+            } else getTargetContext().startService(service);
+            SystemClock.sleep(3000);
+            check(SyncBackgroundService.Companion.getRunning(), "service did not start");
+            check(SyncBackgroundService.Companion.getHoldingWakeLock(), "no CPU wake lock");
+            getUiAutomation().executeShellCommand("input keyevent KEYCODE_HOME").close();
+            SystemClock.sleep(3000);
+            check(SyncBackgroundService.Companion.getRunning(), "service stopped in background");
+            getUiAutomation().executeShellCommand("input keyevent KEYCODE_SLEEP").close();
+            SystemClock.sleep(5000);
+            check(SyncBackgroundService.Companion.getRunning(), "service stopped with screen off");
+            check(SyncBackgroundService.Companion.getHoldingWakeLock(), "wake lock released early");
+            getTargetContext().stopService(service);
+            SystemClock.sleep(2000);
+            check(!SyncBackgroundService.Companion.getRunning(), "service did not stop");
+            check(!SyncBackgroundService.Companion.getHoldingWakeLock(), "wake lock leaked");
+            result.putString("stream", "BACKGROUND_SYNC_SERVICE_PASSED: start, home, screen off, cleanup\n");
+            finish(-1, result);
+        } catch (Throwable error) {
+            result.putString("stream", "BACKGROUND_SYNC_SERVICE_FAILED: " + error + "\n");
+            finish(0, result);
+        } finally {
+            getTargetContext().stopService(service);
+            try { getUiAutomation().executeShellCommand("input keyevent KEYCODE_WAKEUP").close(); }
+            catch (Exception ignored) { }
+        }
+    }
+}
